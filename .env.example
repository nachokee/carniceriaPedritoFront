# Copiá este archivo como .env y ajustá lo que necesites.
# .env está en .gitignore: cada uno tiene el suyo y no se sube al repo.

# URL base del backend (o del API gateway).
VITE_API_URL=http://localhost:8080/api

# Un flag por microservicio. true = datos mockeados, false = backend real.
# Se van pasando a false de a uno, a medida que cada servicio esté listo.
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_CATALOG=true
VITE_USE_MOCK_ORDERS=true
VITE_USE_MOCK_PAYMENTS=true
VITE_USE_MOCK_INVOICES=true
