# Vitest corre en modo "test" y este archivo pisa a .env. Los tests unitarios
# prueban la rama MOCKEADA de cada api/, así que acá los mocks van siempre en
# true, sin importar contra qué backend esté apuntando el .env de desarrollo.
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_CATALOG=true
VITE_USE_MOCK_ORDERS=true
VITE_USE_MOCK_PAYMENTS=true
VITE_USE_MOCK_INVOICES=true
